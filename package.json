{
  "name": "japa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "japa": "./src/cli/main.ts"
  },
  "exports": {
    "./sdk": "./src/sdk.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "build": "cd extensions/webui/app && vite build",
    "prepare": "npm run build",
    "typecheck": "node_modules/@typescript/native/bin/tsc --noEmit && cd extensions/webui/app && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "marked": "18.0.11",
    "playwright-core": "^1.64.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
